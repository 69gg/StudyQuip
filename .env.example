# 默认只用于本机访问。局域网访问必须显式修改 HOST 和允许的来源。
STUDYQUIP_DATA_DIR=data
STUDYQUIP_HOST=127.0.0.1
STUDYQUIP_PORT=8765
STUDYQUIP_ALLOWED_ORIGINS=[]
STUDYQUIP_TIMEZONE=Asia/Shanghai
STUDYQUIP_LEASE_SECONDS=90
STUDYQUIP_HEARTBEAT_SECONDS=15
STUDYQUIP_BUSY_TIMEOUT_MS=5000
STUDYQUIP_OUTPUT_TOKENS=4096
# 单文件上限；按 1024 × 1024 字节换算，1024 MB = 1 GiB。
STUDYQUIP_MAX_UPLOAD_MB=1024
# 流式请求活动写入节奏；前端仍按任务轮询周期更新。
STUDYQUIP_STREAM_PROGRESS_INTERVAL_SECONDS=1
# 缺少的预设科目在用户启动应用时补齐；已有同名复用，重命名后不重建。
STUDYQUIP_DEFAULT_SUBJECTS=["生物","化学","物理","英语","数学"]
# 每种检索方式独立限制返回条数；不进行分数融合。
STUDYQUIP_SEARCH_DEFAULT_LIMIT=12
STUDYQUIP_SEARCH_MAX_LIMIT=100
STUDYQUIP_TOOL_SEARCH_MAX_LIMIT=30
# 题目分部的嵌入批大小和保存后的合并等待；并发仍由模型配置控制。
STUDYQUIP_QUESTION_EMBEDDING_BATCH_SIZE=8
STUDYQUIP_QUESTION_INDEX_DEBOUNCE_SECONDS=2
